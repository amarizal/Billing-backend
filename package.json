{
  "name": "billing-pos-backend",
  "version": "1.0.0",
  "description": "Backend API for PS4/PS5 Rental Billing & POS System",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "build": "npx prisma generate",
    "start": "npx prisma db push && node prisma/seed.js && node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
