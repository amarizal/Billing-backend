# Environment Variables — Billing POS Backend

# ─── Server ───────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────
# Ganti dengan connection string PostgreSQL kamu
DATABASE_URL="postgresql://user:password@localhost:5432/billing_pos_db"

# ─── JWT ──────────────────────────────────────────
JWT_SECRET="ganti_dengan_secret_yang_kuat_dan_panjang_minimal_32_karakter"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="ganti_dengan_refresh_secret_yang_berbeda_dan_panjang"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Smart Plug (Fase 5 - isi nanti) ──────────────
SMART_PLUG_ENABLED=false
TUYA_ACCESS_ID=""
TUYA_ACCESS_SECRET=""
TUYA_BASE_URL="https://openapi.tuyain.com"
